{
  // Type-check the plugin's plain JavaScript. No build step and no emitted
  // output — `tsc --noEmit` is a gate, not a compiler.
  //
  // This lives at the repository root, not inside `cursor-subscription/`,
  // deliberately: ZCode copies the plugin directory verbatim into its install
  // cache, so anything placed there ships to users. An earlier attempt put the
  // dev tooling inside the plugin and shipped 26 MB of compiler with it.
  //
  // The config exists because three defects in a row were the same shape: plain
  // JS where a value could be absent in two ways and nothing checked the shape.
  // A test can only pin a bug someone already thought of; a type makes the bug
  // unrepresentable. `strict` is the point — a lenient config accepts them all.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    // `noImplicitAny` is documentation rather than hazard and accounts for the
    // bulk of the initial diagnostics; it can be tightened per-module over time.
    // `strictNullChecks` — which `strict` implies and which is NOT relaxed here —
    // is the flag that catches this project's actual defect class: a value that
    // can be absent in two ways, where the writer and the reader disagree about
    // which one means "absent".
    "noImplicitAny": false,

    "noImplicitOverride": true,
    // An unused local was a real defect here: `extraSystem` was computed and
    // then never passed, so a JSON-schema request silently produced prose. The
    // compiler sees that; a test did not.
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  // Shipped code only. Tests are type-checked once the library itself is clean;
  // mixing them makes the signal hard to see.
  "include": ["cursor-subscription/lib/**/*.mjs", "cursor-subscription/scripts/**/*.mjs"]
}
