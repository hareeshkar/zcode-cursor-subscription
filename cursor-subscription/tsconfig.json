{
  // Type-check the plugin's plain JavaScript. There is no build step and no
  // emitted output — `tsc --noEmit` is a gate, not a compiler.
  //
  // This exists because three defects in a row were the same shape: plain JS
  // where a value could be absent in two ways and nothing checked the shape.
  // A test can only pin a bug someone already thought of; a type makes the
  // bug unrepresentable. `strict` is the whole point — a lenient config would
  // have accepted every one of them.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    // `noImplicitAny` is mostly documentation and accounts for the bulk of the
    // initial errors; it can be tightened per-module over time. `strictNullChecks`
    // — which `strict` implies and which is NOT relaxed here — is the flag that
    // catches this project's actual defect class: a value that can be absent in
    // two ways, where the writer and the reader disagree about which one.
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  // Shipped code only. Tests are type-checked separately once the library
  // itself is clean; mixing them makes the signal hard to see.
  "include": ["lib/**/*.mjs", "scripts/**/*.mjs"]
}
